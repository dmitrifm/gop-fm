# === ICECAST ===
ICECAST_SOURCE_PASSWORD=source_pass
ICECAST_ADMIN_PASSWORD=admin_pass
ICECAST_RELAY_PASSWORD=relay_pass
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_EMAIL=admin@gop.fm
ICECAST_HOSTNAME=localhost

# === PATHS ===
MUSIC_PATH=/absolute/path/to/your/music
JINGLES_PATH=/absolute/path/to/your/jingles

# === ORCHESTRATOR ===
OPENAI_API_KEY=sk-proj-xxx
TTS_URL=http://tts_api:8005/tts
LLM_SYSTEM_PROMPT="You are Valera, the host of Gop.FM. Keep it short, energetic, funny, and a little chaotic. Use 1-2 sentences max. Write a short radio intro for the upcoming track without sounding boring"

# === TTS API ===
TTS_HOST=0.0.0.0
TTS_PORT=8005
TTS_DEVICE=auto
TTS_PRELOAD=true
TTS_DEFAULT_LANGUAGE=ru
TTS_DEFAULT_EXAGGERATION=0.5
TTS_DEFAULT_CFG_WEIGHT=0.5
TTS_DEFAULT_TEMPERATURE=0.8
TTS_MAX_TEXT_LENGTH=4000
TTS_VOICES_DIR=voices
